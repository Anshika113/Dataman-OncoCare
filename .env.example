# =============================================================================
# DataMan OncoCare — environment configuration (ALL OPTIONAL)
#
# The app is designed to run with NO .env file. In Docker, just:
#
#     docker compose up --build
#
# Every variable below has a working default. Copy this file to `.env` (which
# docker compose reads automatically) only to override a default, e.g. to pin
# the JWT secret or allow a different CORS origin.
# =============================================================================

# --- Backend (FastAPI) ---

# JWT signing secret. If unset, the app derives a stable secret and persists it
# to the data volume, so logins survive a restart of the same deployment.
# Strongly recommended to set this explicitly in real deployments:
#   openssl rand -hex 32
# CARE_SECRET=

# Access-token lifetime in minutes (default 480 = 8h)
# CARE_TOKEN_TTL_MIN=480

# Comma-separated list of allowed browser origins for CORS.
# Defaults cover the same-origin container + the Vite dev server.
# CARE_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173

# Where the Excel datastore lives (defaults to backend/data/care.xlsx;
# Docker sets /data/care.xlsx automatically).
# CARE_DATA_PATH=

# Pin the department clock for demos/testing (HH:MM). Leave unset for real time.
# CARE_NOW=

# Timezone for the department clock. Docker images default to UTC, which puts
# the timeline's "now" marker -- and the auto no-show / overrun triggers -- in
# the wrong hour. docker-compose.yml already sets this; override it here for a
# clinic in another zone.
# TZ=Asia/Kolkata

# --- Patient messaging ---

# Unset: messages are written to the application log and marked delivered, so
# the demo runs without credentials. Set this to the URL of an SMS/WhatsApp
# provider or internal gateway to actually send them. Each message is POSTed as
#   {"to": "<contact>", "channel": "sms", "body": "..."}
# CARE_SMS_WEBHOOK=

# Optional bearer token sent with each webhook call.
# CARE_SMS_TOKEN=

# --- Assistant model ---

# Sarvam AI reads what staff say and picks a view or proposes an action. Unset:
# the phrase matcher answers, there is no mic, and nothing leaves the machine.
# Set: each question or voice clip is sent to Sarvam. Latin-script patient names
# in typed text are masked first; a voice clip goes as it is.
# CARE_SARVAM_KEY=
# CARE_SARVAM_MODEL=sarvam-105b-conversations
# CARE_SARVAM_STT_MODEL=saaras:v3
# CARE_SARVAM_STT_MODE=translit

# --- Frontend (Vite, build-time) ---
# Set to "true" in dev/demo builds to show the Ops Console simulation controls.
# Build with:  docker build --build-arg VITE_DEMO=true ...
# VITE_DEMO=false
