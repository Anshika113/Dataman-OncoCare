# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
venv/
.venv/

# Node
node_modules/
dist/
*.tsbuildinfo

# The Excel datastore is regenerated by `python -m storage.seed`;
# never commit the live one (it contains PHI + password hashes).
backend/data/*.xlsx
backend/data/*.xlsx.tmp
backend/data/*.xlsx.replaced

# The auto-derived JWT salt. It is generated on first run and signs the
# patient link tokens, so committing it would hand anyone who clones the
# repo the ability to mint links for a live deployment.
backend/data/.secret-salt

# Logs
*.log
backend.err.log
frontend.err.log

# Env / secrets
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Syncthing
.stfolder/
.stignore

# Docker image build leftovers and local test output
coverage/

# Build caches
frontend/.vite/
*.tsbuildinfo
.cache/

# Local run artefacts
*.pid
probe*.xlsx
